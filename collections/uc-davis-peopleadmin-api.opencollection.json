{
  "opencollection": "1.0.0",
  "info": {
    "name": "PEAKS API v1 Access PeopleAdmin API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "PeopleAdmin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "POST /api/{teamName}/peopleadmin/Update",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://peaks.ucdavis.edu/api/:teamName/peopleadmin/Update",
            "headers": [
              {
                "name": "X-Auth-Token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "teamName",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "POST /api/{teamName}/peopleadmin/Delete/{id}",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://peaks.ucdavis.edu/api/:teamName/peopleadmin/Delete/:id",
            "headers": [
              {
                "name": "X-Auth-Token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "teamName",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "GET /api/{teamName}/peopleadmin/Details/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://peaks.ucdavis.edu/api/:teamName/peopleadmin/Details/:id",
            "headers": [
              {
                "name": "X-Auth-Token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "showAccessAssignments",
                "value": "",
