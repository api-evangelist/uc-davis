              },
              {
                "name": "showKeySerialAssignments",
                "value": "",
                "type": "query"
              },
              {
                "name": "showEquipmentAssignments",
                "value": "",
                "type": "query"
              },
              {
                "name": "showWorkstationAssignments",
                "value": "",
                "type": "query"
              },
              {
                "name": "showDocuments",
                "value": "",
                "type": "query"
              },
              {
                "name": "teamName",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "Return history records\r\nDefaults to a max of 5 records returned",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://peaks.ucdavis.edu/api/:teamName/peopleadmin/GetHistory/:id",
            "headers": [
              {
                "name": "X-Auth-Token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "the max number of record to take. Defaults to 5"
              },
              {
                "name": "teamName",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Return history records\r\nDefaults to a max of 5 records returned"
        }
      ]
